; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CyberTime"
config/description="Cyberpunk rhythm timing clicker — hit targets on the beat, survive 30 seconds."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon-512.png"
boot_splash/bg_color=Color(0.0392157, 0.0392157, 0.0705882, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

LevelData="*res://scripts/systems/level_data.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
ArcadeFonts="*res://scripts/systems/arcade_fonts.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/test="en"
rendering/force_right_to_left_layout_direction=false
rendering/root_node_layout_direction=1

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
